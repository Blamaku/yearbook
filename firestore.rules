rules_version = '2';

// GLUK Yearbook 2026 — Firestore rules
// Since 9 Oct 2026 Firestore only holds:
//   comments/{id} + comments/{id}/replies/{id}   a read-only archive (comments now live in Supabase)
//   userState/{uid}                              when each person last opened the notification bell
// Profiles, club posts and comments live in Supabase.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Comments moved to Supabase on 9 Oct 2026 (scripts/migrate-comments.mjs copied them all).
    // What stays here is a read-only archive: nobody can add, change or delete anything.
    match /comments/{commentId} {
      allow read: if true;
      allow write: if false;

      match /replies/{replyId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Notification bell: one small private document per person that remembers when they last looked.
    match /userState/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['notifSeenAt'])
        && request.resource.data.notifSeenAt == request.time;
      allow delete: if false;
    }

    // Everything else: denied by default.
  }
}
