# Copy to .env and fill in. .env is git-ignored — never commit real values.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_ANON_KEY=<public anon key — safe in browser code>
SUPABASE_SERVICE_ROLE_KEY=<SECRET — Edge Functions / local scripts only>
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Web Push (phone notifications). The public key is also written into app.js and supabase-api/index.ts.
VAPID_PUBLIC_KEY=<public key>
VAPID_PRIVATE_KEY=<SECRET — Supabase Edge Functions → Secrets only>
